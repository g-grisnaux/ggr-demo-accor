.env
node_modules/
.gradle/
target/
build/
__pycache__/
*.pyc
dist/

# Terraform: provider binaries are large and platform-specific. The lock file
# is committed on purpose so provider versions are reproducible.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# TypeScript incremental build cache
*.tsbuildinfo

# Datadog module state and any local var files
terraform-datadog/.terraform/
terraform-datadog/*.tfstate
terraform-datadog/*.tfstate.*
terraform-datadog/terraform.tfvars
