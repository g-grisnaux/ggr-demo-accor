# Datadog API credentials
DD_API_KEY=your_api_key_here
DD_APP_KEY=your_app_key_here
DD_SITE=datadoghq.com

# Unified Service Tagging
DD_ENV=ggr-demo-accor-260907

# RUM (Frontend)
DD_RUM_APPLICATION_ID=your_rum_app_id_here
DD_RUM_CLIENT_TOKEN=your_rum_client_token_here
# OTel environment (injected when instrumentation mode is "otel" or "ddot")
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=${DD_ENV}
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- GCP -------------------------------------------------------------------
# Projet et service account impersonné. Présents dans le .env réel mais absents
# de cet exemple jusqu'ici, ce qui rendait la reconstruction incomplète.
# Aucune clé JSON : gcloud et le provider Terraform passent tous deux par
# l'impersonation (champ impersonate_service_account).
PROJECT_ID=datadog-ese-sandbox
SERVICE_ACCOUNT=gael-service-account-demo@datadog-ese-sandbox.iam.gserviceaccount.com
